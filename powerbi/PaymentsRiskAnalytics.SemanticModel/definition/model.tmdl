model Model
	culture: en-CA
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-CA
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dw DimCustomer","dw DimDate","dw DimGeography","dw DimMerchant","dw DimPaymentMethod","dw DimTransactionStatus","dw FactTransactions"]

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

ref table 'dw DimCustomer'
ref table 'dw DimDate'
ref table 'dw DimGeography'
ref table 'dw DimMerchant'
ref table 'dw DimPaymentMethod'
ref table 'dw DimTransactionStatus'
ref table 'dw FactTransactions'

ref cultureInfo en-CA

