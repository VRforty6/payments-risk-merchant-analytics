	partition 'dw FactTransactions' = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost", "PaymentsRiskAnalytics"),
				    dw_FactTransactions = Source{[Schema="dw",Item="FactTransactions"]}[Data]
				in
				    dw_FactTransactions

	annotation PBI_ResultType = Table

