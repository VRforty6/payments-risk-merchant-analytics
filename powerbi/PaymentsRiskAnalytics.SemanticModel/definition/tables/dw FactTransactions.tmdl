table 'dw FactTransactions'
	lineageTag: 009633ca-fc84-4684-bffe-58e2eaccfce6

	measure 'Total Transactions' = COUNTROWS('dw FactTransactions')
		formatString: #,0
		displayFolder: Transactions
		lineageTag: 7731cb44-7a99-402b-ae87-b7ca983be0ae

	measure 'Total Transaction Amount' = SUM('dw FactTransactions'[TransactionAmount])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Transactions
		lineageTag: 50e7fd66-9e48-448c-9db2-b02c88b74272

	measure 'Average Transaction Value' = DIVIDE([Total Transaction Amount], [Total Transactions], 0)
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Transactions
		lineageTag: 085cc65c-7ee0-4a43-b5ac-b4d6c2777ac9

	measure 'Approved Transactions' = CALCULATE([Total Transactions], 'dw DimTransactionStatus'[IsApproved] = TRUE())
		formatString: #,0
		displayFolder: Transactions
		lineageTag: 2197d3d9-530b-48ca-99f5-347e4fac74c0

	measure 'Declined Transactions' = CALCULATE([Total Transactions], 'dw DimTransactionStatus'[IsApproved] = FALSE(), 'dw FactTransactions'[TransactionStatusKey] <> 0)
		formatString: #,0
		displayFolder: Transactions
		lineageTag: f51b9a94-202b-44cc-abcd-46f54b7953e1

	measure 'Approval Rate' = DIVIDE([Approved Transactions], [Total Transactions], 0)
		formatString: 0.00%
		displayFolder: Transactions
		lineageTag: 8777694d-ffd8-4de8-a0ff-605859c68f44

	measure 'Decline Rate' = DIVIDE([Declined Transactions], [Total Transactions], 0)
		formatString: 0.00%
		displayFolder: Transactions
		lineageTag: 5691daed-9955-4067-83a8-57681bed7647

	measure 'Refund Count' = CALCULATE([Total Transactions], 'dw FactTransactions'[IsRefunded] = TRUE())
		formatString: #,0
		displayFolder: Refunds
		lineageTag: df9036bf-2ef0-4107-881b-76a19f94e5be

	measure 'Refund Rate' = DIVIDE([Refund Count], [Total Transactions], 0)
		formatString: 0.00%
		displayFolder: Refunds
		lineageTag: 3820aded-3ce6-442d-84aa-a2689485b130

	measure 'Refund Amount' = SUM('dw FactTransactions'[RefundAmount])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Refunds
		lineageTag: 5a9f9d85-f10e-43a2-bb65-a7614addd56a

	measure 'Chargeback Count' = CALCULATE([Total Transactions], 'dw FactTransactions'[IsChargeback] = TRUE())
		formatString: #,0
		displayFolder: Chargebacks
		lineageTag: 59a29af4-b55d-4901-affb-b981eb7102e8

	measure 'Chargeback Rate' = DIVIDE([Chargeback Count], [Total Transactions], 0)
		formatString: 0.00%
		displayFolder: Chargebacks
		lineageTag: 77ca5d8d-b12c-46ea-8743-45b010705a51

	measure 'Chargeback Amount' = SUM('dw FactTransactions'[ChargebackAmount])
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Chargebacks
		lineageTag: c6f17437-997b-4149-905f-67dd7eb07d5d

	measure 'Unique Customers' = DISTINCTCOUNT('dw FactTransactions'[CustomerKey])
		formatString: #,0
		displayFolder: Customers
		lineageTag: b798039c-5250-4400-890a-4e79eebb0f43

	measure 'Active Merchants' = DISTINCTCOUNT('dw FactTransactions'[MerchantKey])
		formatString: #,0
		displayFolder: Risk
		lineageTag: 9d10f9c1-1cb1-4a27-914b-88108022b97f

	measure 'Previous Month Transaction Amount' =
			
			CALCULATE(
			    [Total Transaction Amount],
			    PREVIOUSMONTH('dw DimDate'[DateDate])
			)
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 90c0d044-a9f3-40b9-9f2b-f917a614ecbb

	measure 'MoM Transaction Amount %' = DIVIDE([Total Transaction Amount] - [Previous Month Transaction Amount], [Previous Month Transaction Amount], 0)
		formatString: 0.00%
		displayFolder: Time Intelligence
		lineageTag: b1da1e4e-768f-4565-a823-61d051609a48

	measure 'Rolling 30 Day Transaction Amount' =
			
			CALCULATE(
			    [Total Transaction Amount],
			    DATESINPERIOD('dw DimDate'[DateDate], MAX('dw DimDate'[DateDate]), -30, DAY)
			)
		formatString: $#,0.00;-$#,0.00;$#,0.00
		displayFolder: Time Intelligence
		lineageTag: 259a25cd-4c13-4b64-a755-79b603278cc6

	measure 'Merchant Risk Tier Index' =
			
			AVERAGEX(
			    VALUES('dw DimMerchant'[MerchantKey]),
			    VAR CurrentRiskTier =
			        CALCULATE(SELECTEDVALUE('dw DimMerchant'[RiskTier]))
			    RETURN
			    SWITCH(
			        CurrentRiskTier,
			        "high", 3,
			        "medium", 2,
			        "low", 1,
			        BLANK()
			    )
			)
		formatString: 0.0
		displayFolder: Risk
		lineageTag: cb11e900-5a8e-4c88-b851-ba1b0ef83ee4

